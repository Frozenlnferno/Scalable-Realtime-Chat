VITE_COGNITO_USER_POOL_ID=us-east-2_example
VITE_COGNITO_USER_POOL_CLIENT_ID=exampleclientid
VITE_COGNITO_REGION=us-east-2

# Browser-facing local endpoints
VITE_API_URL=http://localhost:3000
VITE_SOCKET_URL=http://localhost:3000
CLIENT_ORIGIN=http://localhost:5173

# Docker Compose PostgreSQL (local stand-in for RDS)
POSTGRES_DB=chat
POSTGRES_USER=chat
POSTGRES_PASSWORD=chat

# Server-only Pub/Sub. Compose uses its local Redis service when this is empty.
# A backend started directly uses in-memory delivery when this is empty.
# Use the primary endpoint of a cluster-mode-disabled cache; URL-encode credentials.
# REDIS_URL=rediss://username:password@your-primary-endpoint:6379
REDIS_URL=
REDIS_KEY_PREFIX=chat:socket.io
